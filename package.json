{
  "name": "grunt-standard",
  "version": "4.0.0",
  "description": "Grunt Plugin for JavaScript Standard Style Linting and Formatting",
  "main": "tasks/standard.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasyAsABC123/grunt-standard.git"
  },
  "author": {
    "name": "Justin Schuhmann",
    "email": "jmschu02@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/EasyAsABC123/grunt-standard/issues"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "is-glob": "^4.0.3",
    "standard": "^17.1.2",
    "text-table": "^0.2.0"
  },
  "devDependencies": {
    "grunt": "^1.6.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "homepage": "https://github.com/EasyAsABC123/grunt-standard",
  "standard": {
    "globals": [
      "grunt"
    ]
  },
  "scripts": {
    "outdated": "npm outdated --depth 0",
    "lint": "grunt",
    "test": "npm run lint && npm run test:coverage && npm run test:integration",
    "audit": "npm audit",
    "test:unit": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test-coverage-include='lib/**' --test-coverage-include='tasks/**' --test-coverage-include='scripts/**' test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "files": [
    "tasks/",
    "lib/",
    "README.md",
    "CONTRIBUTE.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "overrides": {
    "grunt-legacy-log": "^3.0.1",
    "grunt-legacy-log-utils": "^2.1.3",
    "grunt-legacy-util": "^2.0.2"
  }
}
